	(text "TPESD0402G05V\nBidirectional ultra-low capacitance (0.05 pF) \nESD protection diodes on input connectors.\nNo polarity - either pin may be tied to GND.\nProtects from ESD & cable transients."
		(exclude_from_sim no)
		(at 190.5 146.05 0)
		(effects
			(font
				(size 1.778 1.778)
			)
