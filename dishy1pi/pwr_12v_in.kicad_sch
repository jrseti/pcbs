	(text "Circuit to convert 12V DC to 5V DC\n12V is reverse polatiry and over voltage protected\nMP2322 used to convert 12V to 5V DC\n12V DC out will draw max 200mA, powering each encoder\n5V DC out will draw max 300mA and power the board\nBuck modeled after John Teel's YouTube video: \n	https://www.youtube.com/watch?v=rLHW4gU6idU\n	and referencing the MP2322 datasheet"
		(exclude_from_sim no)
		(at 24.13 93.98 0)
		(effects
			(font
				(size 2.032 2.032)
			)
			(justify left)
		)
		(uuid "b9421007-593a-4eba-9e3c-57b24f6a0928")
	)
