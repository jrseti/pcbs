	)
	(text "ID_SD and ID_SC PINS:\nThese pins are reserved for \nHAT ID EEPROM.\n\nAt boot time this I2C interface \nwill be interrogated to look for\nan EEPROM that identifes the \nattached boar.\n\nBridging JP1 enables write \nprotection.\n"
		(exclude_from_sim no)
		(at 83.82 168.91 0)
		(effects
			(font
				(size 1.778 1.778)
			)
			(justify left bottom)
		)
		(uuid "8714082a-55fe-4a29-9d48-99ae1ef73073")
