	(text "Purpose: A development PCB to test:\n\n	-MCU (STM32G4131) works and is programmable over JTAG\n	 and optionally Boot0/UART\n	-MCU can communicate with off-board I2C sensors\n	-MCU can output stepper PWM and read encoder inputs\n	-Provide a test-bed to develop a PID control\n	 of the stepper motor\n	-PWM, encoders and limit switches are opto-isolated \n	 from the MCU (see IO sheet)\n	-Pi can send and receive commands/status via UART"
		(exclude_from_sim no)
		(at 102.87 29.21 0)
		(effects
			(font
				(size 1.778 1.778)
			)
			(justify left)
		)
		(uuid "e50af63d-ba1a-4213-b30e-a1a9ced2cf7c")
	)
	(text "5V_PI to\n MCU 3.3V"
