{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug STM32 (J-Link)",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/axis_controller_lqfp64_rev10.elf",
            "request": "launch",
            "type": "cortex-debug",
            "runToEntryPoint": "main",
            "servertype": "jlink",
            "device": "STM32G474RE",
            "interface": "swd",
            "showDevDebugOutput": "none",
            "swoConfig": {
                "enabled": true,
                "cpuFrequency": 170000000,
                "swoFrequency": 2000000,
                "source": "probe",
                "decoders": [
                    {
                        "type": "console",
                        "label": "ITM",
                        "port": 0
                    }
                ]
            }
        }
    ]
}