		(uuid "02e05a4f-42bd-44ce-9d0f-d988d66b2ee4")
	)
	(text "Switch:\nPins 1,2,3 are the address of this board\non the RS485 bus. Pin 4 is an extra pin \nthat may be of future use, but not used now."
