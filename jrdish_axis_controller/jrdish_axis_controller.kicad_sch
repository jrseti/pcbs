		(uuid "02e05a4f-42bd-44ce-9d0f-d988d66b2ee4")
	)
	(text "Switch:\nPins 1,2,3 are the address of this board\non the RS485_1 bus. Pin 4 is an extra pin \nthat may be of future use, but not used now."
		(exclude_from_sim no)
		(at 132.842 107.442 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
