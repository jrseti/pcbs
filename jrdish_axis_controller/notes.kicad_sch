(kicad_sch
	(version 20260306)
	(generator "eeschema")
	(generator_version "10.0")
	(uuid "b33e0d4a-cbbf-4030-9279-e2ab0e38b6f1")
	(paper "A4")
	(title_block
		(date "2026-04-12")
		(rev "1.0")
		(company "JRSeti")
	)
	(lib_symbols)
	(text "Purpose: Control dual axes of a motor controlled\nsystem.\n\n- Modbus commands over isolated RS485 from a host.\n- MCU outputs motor PWM, direction, enable/disable\n- Input from encoder connected to motor output\n- Host provides configuration and position commands\n- MCU runs a PID loop to position/move motors\n- Onboard temperature sensor, MCU can turn fan on/off\n- I2C extender for sensors placed at the axes\n- 1PPS input from a GPS\n- NMEA sentences and 1PPS from a NEO-M9N"
		(exclude_from_sim no)
		(at 28.956 45.466 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "502df861-08d4-4a8e-b2dc-f427feabe0a0")
	)
	(text "MCU is the STM32G474CET6, 48-pin LQFP48 package\nSpeed and position connands are received from a host over RS485.\nEncoder is the E6B2-CWZ6C.\nMotor Controller: DM556Y.\n2-Wire program/debug connector with SWO.\nI2C for reading I2C sensors.\n2 Limit switches.\nUSART communication to Host.\n16MHz oscillator, prescalers configures for 48MHz.\n\nThe STM32G474 datasheet is at https://www.st.com/resource/en/datasheet/stm32g474ce.pdf\nSee figure 6 and table 12 in the datasheet for the STM32G474CET6 pinouts for the LQFP48 package.\n\n\nMCU Specifications\nPart Number: STM32G474CET6\nPackage: LQFP48\nClock: 48 MHz (16 MHz crystal + PLL)\nFlash: 512 KB\nRAM: 128 KB\n"
		(exclude_from_sim no)
		(at 23.876 82.804 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "5e94f6af-6242-483e-96b4-dd7da6174902")
	)
	(text "NOTES"
		(exclude_from_sim no)
		(at 34.798 20.828 0)
		(effects
			(font
				(size 5.08 5.08)
			)
		)
		(uuid "bec4a1e9-2156-449d-a699-b91cfad0b06f")
	)
	(text "This STM32 can be clocked up to 170MHz. It was decided to\ndecrease this to 48MHz due to RFI concerns. The 48MHz\nproduces much weaker harmonics above 1GHz compared to\n170MHz. If speed ever becomes a concern the clock rate\ncan be increased."
		(exclude_from_sim no)
		(at 23.876 113.792 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "dda6f144-5632-48c0-a16a-8884b502e30c")
	)
