	(text "To select RS232:\n  H5 - Jumper on pins 2-3\n  H7 - Jumper on pins 1-2\n  H6 - Jumper on pins 2-3\n  D8 - Jumper in pins 1-2\nTo select CMOS level:\n  H5 - Jumper on pins 1-2\n  H7 - Jumper OFF\n  H6 - Jumper on pins 1-2\n  H8 - Jumper OFF"
		(exclude_from_sim no)
		(at 235.458 112.014 0)
		(effects
