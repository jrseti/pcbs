	(text "H3/H4 are the I2C pull-up resistors. Jumper\nshould be in place by default, unless an \nexternal module supplies pull-up resistors."
		(exclude_from_sim no)
		(at 152.146 86.614 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "84ed424f-c6d8-4ae7-9023-5f954176a744")
	)
	(text "QE bit = 1, so IO2 and IO3 are active inputs.\nNot using quad SPI here, so pull up to 3V3."
		(exclude_from_sim no)
		(at 84.582 145.542 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "9a6f857f-1fb8-45dc-bef6-b0332f5434cf")
	)
	(text "The I2C pull-up resistors are on jumpers because some I2C sensors on the line\nmay have their own pull-up, so the jumpers allow removing the pull-ups \nin this case."
		(exclude_from_sim no)
		(at 152.146 93.726 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "aa65c50c-4485-4d23-bb95-1de3a02f0cbb")
	)
	(text "Not using in quad mode so\nIO2 and IO3 are pulled high."
		(exclude_from_sim no)
		(at 83.058 135.89 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "cd9c248c-fba1-4c8a-9c99-e6a686896b14")
	)
